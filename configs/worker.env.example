ANTHROPIC_API_KEY=replace-with-api-key
# Personal inbox classification, off unless both are set (TYPESAFE_API_KEY is
# already used for model routing). Summaries use the logged-in Codex CLI, so
# there is no second API key; CHATTING_PERSONAL_SUMMARY_MODEL is optional and
# selects the Codex model.
TYPESAFE_API_KEY=replace-with-typesafe-api-key
CHATTING_PERSONAL_CACHE_PATH=/var/lib/chatting-worker/personal-inbox-cache.db
