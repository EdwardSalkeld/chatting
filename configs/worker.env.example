ANTHROPIC_API_KEY=replace-with-api-key
# Personal inbox classification, off unless all four are set (TYPESAFE_API_KEY
# is already used for model routing).
TYPESAFE_API_KEY=replace-with-typesafe-api-key
CHATTING_PERSONAL_SUMMARY_API_KEY=replace-with-summary-model-key
CHATTING_PERSONAL_SUMMARY_MODEL=replace-with-structured-output-model
CHATTING_PERSONAL_CACHE_PATH=/var/lib/chatting-worker/personal-inbox-cache.db
